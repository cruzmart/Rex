# -------------------------------
# Build and binary directories
# -------------------------------
build/                  # CMake / LLVM build folder
bin/                    # compiled executables
out/                    # optional build output folder
cmake-build-*/         # CLion / CMake IDE builds

# -------------------------------
# CMake artifacts
# -------------------------------
CMakeFiles/             # CMake temporary build dirs
CMakeCache.txt          # CMake cache
cmake_install.cmake     # CMake install helper
Makefile                # generated Makefiles (optional)
*.ninja                 # Ninja build files
CMakeUserPresets.json   # modern CMake presets

# -------------------------------
# Generated ANTLR sources
# -------------------------------
gen/                    # ANTLR-generated sources
grammar/.antlr/         # ANTLR temp files

# -------------------------------
# LLVM / MLIR / Clang caches & outputs
# -------------------------------
*.o                     # object files
*.a                     # static libraries
*.so                    # shared libraries
*.bc                    # LLVM bitcode files
*.ll                    # LLVM IR files
*.opt.bc                # optimized bitcode
*.dylib                 # macOS dynamic libs
*.tmp                   # temporary files
*.log                   # log files
*.tds                   # tablegen generated files
*.inc                   # LLVM/MLIR includes generated by tablegen

# -------------------------------
# Caches
# -------------------------------
.cache/                 # generic cache folder
.cache/clangd/          # clangd cache

# -------------------------------
# IDE-specific files
# -------------------------------
.vscode/                # VSCode
.idea/                  # JetBrains IDEs (CLion, etc.)
*.iml                   # JetBrains module files


# -------------------------------
# Miscellaneous / OS files
# -------------------------------
.DS_Store               # macOS
Thumbs.db               # Windows